#!/bin/bash
set -euo pipefail
umask 077
exec > >(tee -a /var/log/codex-airlift-bootstrap.log) 2>&1
export DEBIAN_FRONTEND=noninteractive
rm -f /var/lib/codex-airlift-ready
apt-get update -q
apt-get install -y -q ca-certificates curl git nodejs npm python3 python3-venv rsync ripgrep tmux build-essential unzip bubblewrap apparmor-profiles apparmor-utils
install -m 0644 /usr/share/apparmor/extra-profiles/bwrap-userns-restrict /etc/apparmor.d/bwrap-userns-restrict
apparmor_parser -r /etc/apparmor.d/bwrap-userns-restrict
if ! id codex >/dev/null 2>&1; then
  useradd --create-home --shell /bin/bash codex
fi
install -d -o codex -g codex -m 700 /home/codex/.codex /home/codex/.local/bin /home/codex/projects
# Daemon bootstrap requires the vendor-managed standalone installation; an npm
# installation of the same version is insufficient. Pin the reviewed installer
# and requested release; the installer also verifies the release archive digest.
installer=$(mktemp)
trap 'rm -f "$installer"' EXIT
curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 https://chatgpt.com/codex/install.sh -o "$installer"
echo "44ac252c1b9a68c02bdf0de8e1c6cbfde36fc1afa8684624962eae7d4c461e70  $installer" | sha256sum --check
runuser -u codex -- env HOME=/home/codex CODEX_NON_INTERACTIVE=1 sh -s -- --release '${codex_version}' < "$installer"
ln -sfn /home/codex/.local/bin/codex /usr/local/bin/codex
ln -sfn /home/codex/.local/bin/codex-code-mode-host /usr/local/bin/codex-code-mode-host
loginctl enable-linger codex
runuser -u codex -- /usr/local/bin/codex --version
# Keep the managed daemon alive across both SSH disconnects and VM restarts.
cat > /etc/systemd/system/codex-airlift-daemon.service <<'UNIT'
[Unit]
Description=Codex Airlift managed app-server
Wants=network-online.target
After=network-online.target google-startup-scripts.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=codex
Environment=HOME=/home/codex
ExecStart=/usr/local/bin/codex app-server daemon start
ExecStop=/usr/local/bin/codex app-server daemon stop
TimeoutStartSec=120
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable codex-airlift-daemon.service
systemctl start --no-block codex-airlift-daemon.service
# Bootstrap does not authenticate, copy chats, or change Codex permissions.
touch /var/lib/codex-airlift-ready
